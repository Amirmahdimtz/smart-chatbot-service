  "security_policies": [
    {
      "id": "SEC-01",
      "name": "Public publication gate",
      "rule": "Public retrieval only from explicitly approved/public/current document versions; never internal HR or unreleased sources."
    },
    {
      "id": "SEC-02",
      "name": "HR purpose-scoped access",
      "rule": "HR personnel/profile/position data requires authenticated authorized staff, approved purpose and minimal attributes; human decides."
    },
    {
      "id": "SEC-03",
      "name": "Conversation ownership",
      "rule": "Principal may read only owned or explicitly delegated conversations; no cross-user retrieval."
    },
    {
      "id": "SEC-04",
      "name": "Research source restriction",
      "rule": "Research sources filtered by classification, unit, confidentiality and version; evidence authorization rechecked."
    },
    {
      "id": "SEC-05",
      "name": "Consent and development privacy",
      "rule": "Learning profile and long-term memory require approved legal basis/consent; managers do not implicitly inherit access."
    },
    {
      "id": "SEC-06",
      "name": "Approved actions",
      "rule": "No position change/task assignment without approver authority, fresh resource checks, destination authorization and audit."
    },
    {
      "id": "SEC-07",
      "name": "Agent deny by default",
      "rule": "External Agent absent; no side-effecting call until signed contract, service identity, approval and integration verification."
    },
    {
      "id": "SEC-08",
      "name": "Grounding and source safety",
      "rule": "Untrusted retrieved content cannot issue instructions; only validated, currently published, authorized citations may ground answers."
    },
    {
      "id": "SEC-09",
      "name": "Data minimization and logging",
      "rule": "Mask confidential prompts, personnel records and secrets in logs, traces, agent requests and evaluation samples."
    }
  ],
